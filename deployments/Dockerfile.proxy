FROM golang:1.27.4-alpine3.24 AS build
WORKDIR /src

COPY go.mod ./
COPY internal/ ./internal/
COPY cmd/proxy/ ./cmd/proxy/
RUN GOOS=linux CGO_ENABLED=0 GOTOOLCHAIN=local go build -trimpath -o /out/proxy ./cmd/proxy

FROM gcr.io/distroless/static-debian13:nonroot
COPY --from=build /out/proxy /proxy
ENTRYPOINT ["/proxy"]
